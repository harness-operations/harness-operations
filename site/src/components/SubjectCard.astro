---
import { kindLabel, safeUrl, subjectPath, isReviewedSource, scopeRows } from '../lib/discovery.mjs';
const { subject } = Astro.props;
---
<article class="ho-option" data-subject-id={subject.id}>
  <p class="ho-option-kind">{kindLabel(subject)}</p>
  <h3><a href={subjectPath(subject)}>{subject.name}</a></h3>
  <p data-why hidden></p>
  <dl>
    {scopeRows(subject).map(({ key, label, value }) => <><dt data-scope-key={key}>{label}</dt><dd>{value}</dd></>)}
    <dt>Reviewed</dt><dd><time datetime={subject.reviewed_at}>{subject.reviewed_at}</time></dd>
  </dl>
  <p class="ho-option-limit">{subject.notes || 'Read the system entry for setup, execution boundaries, and limitations.'}</p>
  <details>
    <summary>Sources and limitations</summary>
    <p>These links support the reviewed catalog entry. Inclusion is not a live-test result, a claim of current availability, or a guarantee about privacy, price, offline use, or compatibility.</p>
    <ul>
      {subject.sources.filter(isReviewedSource).map((source) => <li><a href={safeUrl(source.url)}>{source.title || 'Source'}</a> <span>({source.type.replaceAll('_', ' ')})</span></li>)}
    </ul>
    <p><a href={subjectPath(subject)}>Read the full entry and its limitations →</a></p>
  </details>
</article>
<style>
  .ho-option { padding: 1.25rem; border: 1px solid var(--sl-color-hairline); border-radius: .85rem; background: var(--sl-color-bg); min-width: 0; overflow-wrap: anywhere; }
  .ho-option h3 { margin: .35rem 0 .85rem; font-size: 1.2rem; }
  .ho-option-kind { margin: 0; color: var(--sl-color-gray-2); font-size: .8rem; }
  .ho-option dl { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: .3rem .8rem; margin: 1rem 0; font-size: .88rem; }
  .ho-option dt { font-weight: 600; }
  .ho-option dd { margin: 0; }
  .ho-option-limit, .ho-option details { font-size: .9rem; }
  .ho-option details { margin-top: 1rem; }
  .ho-option summary { cursor: pointer; font-weight: 600; }
  @media (max-width: 32rem) { .ho-option dl { grid-template-columns: 1fr; } .ho-option dd { margin-bottom: .5rem; } }
</style>
