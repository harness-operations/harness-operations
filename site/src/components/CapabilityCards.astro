---
import { topics } from '../lib/guide-topics.mjs';
---
<div class="ho-capability-grid">
  {topics.map((topic) => <a href={`/capabilities/${topic.id}/`}><strong>{topic.title} <span aria-hidden="true">↗</span></strong><span>{topic.short}</span></a>)}
</div>
<style>
  .ho-capability-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 1.5rem 0; }
  .ho-capability-grid a { display: grid; gap: .25rem; padding: 1.05rem 1.15rem; border: 1px solid var(--sl-color-hairline); border-radius: .7rem; text-decoration: none; color: var(--sl-color-text); }
  .ho-capability-grid a:hover { border-color: var(--sl-color-text-accent); }
  .ho-capability-grid a > span { color: var(--sl-color-gray-2); font-size: .9rem; }
  .ho-capability-grid strong { display: flex; justify-content: space-between; gap: .5rem; }
  @media (max-width: 36rem) { .ho-capability-grid { grid-template-columns: 1fr; } }
</style>
